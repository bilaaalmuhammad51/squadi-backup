# ---------- App under test ----------
# Which app profile to load (tests/config/apps). Case-insensitive.
# Supported: Squadi | Basketball
APP=Squadi

# ---------- Platform / execution ----------
# PLATFORM=android|ios      ENV=local|browserstack
PLATFORM=android
ENV=local

# ---------- BrowserStack ----------
BROWSERSTACK_USERNAME=your_username
BROWSERSTACK_ACCESS_KEY=your_access_key
# Per-app uploaded build ids. These override the ids in the app profile, so you
# can point a run at a fresh upload without editing code.
# BROWSERSTACK_APP_ID=bs://...        # Android build
# BROWSERSTACK_IOS_APP_ID=bs://...    # iOS build

# ---------- Local iOS device (optional) ----------
# IOS_DEVICE_NAME=iPhone SE
# IOS_PLATFORM_VERSION=18.3
# IOS_UDID=00008110-001109290E11A01E

# ---------- App profile overrides (optional) ----------
# Every value below defaults to the active app profile. Set one only while you
# are still pinning down a new app's environment - then move it into the
# profile file so CI gets it too.
# APP_APK=basketball-qa.apk
# APP_IPA=basketball-qa.ipa
# API_USERS_BASE_URL=https://api-dev1.squadi.com/users
# API_LIVESCORES_BASE_URL=https://api-dev1.squadi.com/livescores
# SEED_COMPETITION_ID=239
# SEED_ORGANISATION_ID=58
# SEED_DIVISION_ID=541
# SEED_TEAM1_ID=2269
# SEED_TEAM2_ID=2270
# SEED_VENUE_COURT_ID=42
# SEED_ROUND_ID=13215
# SEED_MATCH_TYPE=FOUR_QUARTERS
